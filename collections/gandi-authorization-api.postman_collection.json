      },
      "item": [
        {
          "id": "3aaa4c0e-239b-4fbc-8c52-e30de4fff766",
          "name": "Reset auth code",
          "request": {
            "name": "Reset auth code",
            "description": {
              "content": "Reset the registry authorization code for a domain.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "domains",
                ":domain",
                "authinfo"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "domain",
                  "description": "(Required) "
                }
              ]
            },
            "method": "PUT",
            "auth": null
          },
          "response": [
            {
              "id": "8a56906f-c8c9-4470-b298-bebac5f18c46",
              "name": "Auth code reset.",
              "originalRequest": {
                "url": {
                  "path": [
                    "domains",
                    ":domain",
                    "authinfo"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "domain",
                      "description": "(Required) "
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  }
                ],
                "method": "PUT",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/plain"
                }
              ],
              "body": "",
              "cookie": [],
              "_postman_previewlanguage": "text"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
